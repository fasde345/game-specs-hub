                // Формат для ПК-игр
                const specsTable = (specs, title) => `
                    <h3>${title}</h3>
                    <ul>
                        <li><strong>Процессор (CPU):</strong> <span>${specs.cpu}</span></li>
                        <li><strong>Видеокарта (GPU):</strong> <span>${specs.gpu}</span></li>
                        <li><strong>ОЗУ (RAM):</strong> <span>${specs.ram}</span></li>
                        <li><strong>Место на диске:</strong> <span>${specs.storage}</span></li>
                    </ul>
                `;
                specsHtml = `${specsTable(game.min, 'Минимальные требования')}${specsTable(game.rec, 'Рекомендуемые требования')}`;
            } else {
                // Упрощенный формат для Мобильных игр
                const specsMobileTable = (specs, title) => `
                    <h3>${title}</h3>
                    <ul>
                        <li><strong>ОС:</strong> <span>${specs.os}</span></li>
                        <li><strong>ОЗУ (RAM):</strong> <span>${specs.ram}</span></li>
                        <li><strong>Место:</strong> <span>${specs.storage}</span></li>
                    </ul>
                `;
                specsHtml = `${specsMobileTable(game.min, 'Мин. требования (Mobile)')}${specsMobileTable(game.rec, 'Рек. требования (Mobile)')}`;
            }

            return `
                <div class="${cardClass}" data-genre="${game.genre}">
                    <div class="game-image-container">
                        <img src="${game.image}" alt="Обложка игры ${game.name}" loading="lazy">
                    </div>
                    <h2>${game.name} (${isPC ? 'ПК' : 'Мобильная'})</h2>
                    <div class="specs-section">
                        <p><strong>Жанр:</strong> ${game.genre}</p>
                        ${specsHtml}
                    </div>
                </div>
            `;
        }

        // --- 3. Функции фильтрации и отображения ---

        /**
         * Получает текущее состояние фильтров из LocalStorage.
         */
        function getFilterSettings() {
            // Мобильные игры по умолчанию ВЫКЛЮЧЕНЫ (false)
            const mobileEnabled = localStorage.getItem('mobile-enabled') === 'true';
            // ПК-игры по умолчанию ВКЛЮЧЕНЫ (true)
            const pcEnabled = localStorage.getItem('pc-enabled') !== 'false'; // Изначально true, если нет значения

            return { mobileEnabled, pcEnabled };
        }

        /**
         * Объединяет и фильтрует игры перед отображением.
         */
        function applyFilters() {
            const { mobileEnabled, pcEnabled } = getFilterSettings();
            const searchText = document.getElementById('search-input').value.toLowerCase().trim();
            
            let allGames = [];
            
            if (pcEnabled) {
                allGames = allGames.concat(pcGameData.map(g => ({ ...g, type: 'pc' })));
            }
            if (mobileEnabled) {
                allGames = allGames.concat(mobileGameData);
            }

            const filteredGames = allGames.filter(game => {
                const matchesSearch = game.name.toLowerCase().includes(searchText) || 
                                      game.genre.toLowerCase().includes(searchText);

                // Дополнительный фильтр по жанру (удален для простоты, можно вернуть)
                // const matchesGenre = !selectedGenre || game.genre.includes(selectedGenre);

                return matchesSearch;
            });

            displayGames(filteredGames);
        }

        /**
         * Отображает список игр на странице.
         */
        function displayGames(gamesToDisplay) {
            const listElement = document.getElementById('game-list');
            
            if (gamesToDisplay.length === 0) {
                listElement.innerHTML = '<p style="text-align: center; color: #ffcc00;">К сожалению, игры по вашему запросу не найдены. Проверьте настройки!</p>';
                return;
            }

            const html = gamesToDisplay.map(createGameCard).join('');
            listElement.innerHTML = html;
        }

        // --- 4. Логика Настроек (Toggles) ---

        /**
         * Сохраняет состояние ползунка в LocalStorage и обновляет каталог.
         */
        function handleToggleChange(event) {
            const checkbox = event.target;
            const key = checkbox.dataset.key;
            localStorage.setItem(key, checkbox.checked);
            applyFilters();
        }

        /**
         * Загружает состояние ползунков из LocalStorage при запуске.
         */
        function loadSettings() {
            const { mobileEnabled, pcEnabled } = getFilterSettings();

            const mobileToggle = document.getElementById('toggle-mobile');
            const pcToggle = document.getElementById('toggle-pc');

            // Установка начальных состояний
            mobileToggle.checked = mobileEnabled;
            pcToggle.checked = pcEnabled;

            // Добавление слушателей
            mobileToggle.addEventListener('change', handleToggleChange);
            pcToggle.addEventListener('change', handleToggleChange);
        }

        // --- 5. Логика Вкладок ---

        function setupTabs() {
            const tabsContainer = document.getElementById('tabs');
            const tabButtons = tabsContainer.querySelectorAll('.tab-button');
            const pages = document.querySelectorAll('.content-section');

            tabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    // Скрыть все страницы
                    pages.forEach(page => {
                        page.style.display = 'none';
                    });

                    // Убрать активный класс со всех кнопок
                    tabButtons.forEach(btn => {
                        btn.classList.remove('active');
                    });

                    // Показать нужную страницу и сделать кнопку активной
                    const targetPageId = button.dataset.tab;
                    document.getElementById(targetPageId).style.display = 'block';
                    button.classList.add('active');

                    // При переключении на каталог, обновить список
                    if (targetPageId === 'catalog-page') {
                        applyFilters();
                    }
                });
            });
        }

        // --- 6. Инициализация ---

        document.addEventListener('DOMContentLoaded', () => {
            // Установка начальных значений в LocalStorage, если они отсутствуют
            if (localStorage.getItem('mobile-enabled') === null) {
                localStorage.setItem('mobile-enabled', 'false'); // Мобильные по умолчанию ВЫКЛ.
            }
            if (localStorage.getItem('pc-enabled') === null) {
                localStorage.setItem('pc-enabled', 'true'); // ПК по умолчанию ВКЛ.
            }

            document.getElementById('loading-message').style.display = 'none';
            
            setupTabs();
            loadSettings();
            applyFilters(); // Первоначальная загрузка данных на основе настроек

            document.getElementById('search-input').addEventListener('input', applyFilters);
        });
    </script>
</body>
</html>
