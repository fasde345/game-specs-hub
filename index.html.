            color: #e0e0e0;
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Шапка и Навигация */
        header {
            background: linear-gradient(90deg, #1f4068, #162447);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
        }

        #tabs {
            display: flex;
            justify-content: center;
            border-bottom: 2px solid #2c3e50;
        }

        .tab-button {
            padding: 15px 30px;
            cursor: pointer;
            background: none;
            border: none;
            color: #90a4ae;
            font-size: 1.1em;
            transition: color 0.3s, background-color 0.3s;
        }

        .tab-button:hover {
            color: #ffcc00;
        }

        .tab-button.active {
            color: #ffcc00;
            border-bottom: 3px solid #ffcc00;
            background-color: #1a2a40;
        }

        /* Основные секции */
        .content-section {
            padding-top: 30px;
        }

        #game-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        /* Карточки игр (ПК и Мобильные) */
        .game-card {
            background-color: #1e1e1e;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.6);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .game-image-container {
            height: 180px;
            overflow: hidden;
            background-color: #000;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .game-image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .game-card h2 {
            background-color: #333;
            color: #ffcc00;
            margin: 0;
            padding: 15px;
            font-size: 1.5em;
            text-align: center;
        }

        .specs-section {
            padding: 15px;
        }

        .specs-section h3 {
            color: #5b9bd5;
            border-bottom: 1px solid #333;
            padding-bottom: 5px;
            margin-top: 15px;
            margin-bottom: 10px;
        }

        .specs-section ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .specs-section li {
            padding: 5px 0;
            display: flex;
            justify-content: space-between;
            font-size: 0.9em;
        }

        .specs-section li strong {
            color: #e0e0e0;
        }
        
        /* Стили для мобильных игр */
        .game-card.mobile h2 {
            background-color: #383838; /* Другой цвет для отличия */
            color: #00bcd4;
        }

        /* --- Стили для Настроек --- */
        #settings-page {
            max-width: 600px;
            margin: 50px auto;
            padding: 20px;
            background-color: #1e1e1e;
            border-radius: 12px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4);
        }
        
        .setting-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid #333;
        }

        .setting-item:last-child {
            border-bottom: none;
        }

        .setting-item label {
            font-size: 1.1em;
            font-weight: bold;
        }
        
        /* Стили для ползунка (Toggle Switch) */
        .switch {
            position: relative;
            display: inline-block;
            width: 60px;
            height: 34px;
        }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 34px;
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

        input:checked + .slider {
            background-color: #ffcc00;
        }

        input:focus + .slider {
            box-shadow: 0 0 1px #ffcc00;
        }

        input:checked + .slider:before {
            transform: translateX(26px);
        }
